generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  SELLER_STAFF
  MODERATOR
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SellerStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum BusinessType {
  INDIVIDUAL
  PARTNERSHIP
  PRIVATE_LIMITED
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductModerationStatus {
  PENDING_REVIEW
  APPROVED
  DISABLED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

enum InventoryAdjustmentReason {
  INITIAL_STOCK
  RESTOCK
  CORRECTION
  DAMAGE
  RETURN
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SellerOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  displayName  String
  role         UserRole     @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  seller       Seller?
  sellerApplication SellerApplication?
  sellerActions SellerHistory[] @relation("SellerHistoryActor")
  moderatedProducts    Product[]                     @relation("ProductModerator")
  inventoryAdjustments ProductInventoryAdjustment[] @relation("InventoryAdjustmentActor")
  orders       Order[]
  refreshSessions RefreshSession[]
  authTokens   AuthActionToken[]
  reviews      Review[]
  wishlist     WishlistItem[]
  auditEvents  AuditLog[]   @relation("AuditActor")

  @@index([role, createdAt])
}

model AuthActionToken {
  id         String          @id @default(cuid())
  userId     String
  tokenHash  String          @unique
  purpose    AuthTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Seller {
  id          String       @id @default(cuid())
  userId      String       @unique
  slug        String       @unique
  displayName String
  businessName String?
  businessType BusinessType @default(INDIVIDUAL)
  description String       @default("") @db.VarChar(2000)
  contactEmail String?     @db.VarChar(254)
  contactPhone String?     @db.VarChar(30)
  logoUrl     String?      @db.VarChar(2048)
  bannerUrl   String?      @db.VarChar(2048)
  shippingPolicy String?   @db.VarChar(2000)
  returnPolicy String?     @db.VarChar(2000)
  status      SellerStatus @default(PENDING)
  commissionBps Int        @default(1200)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  products    Product[]
  suborders   SellerOrder[]
  history     SellerHistory[]

  @@index([status, createdAt])
}

model SellerApplication {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  businessName       String                  @db.VarChar(120)
  storeName          String                  @db.VarChar(100)
  storeNameNormalized String                 @unique @db.VarChar(100)
  businessType       BusinessType
  description        String                  @db.VarChar(2000)
  contactEmail       String                  @db.VarChar(254)
  contactPhone       String                  @db.VarChar(30)
  addressLine1       String                  @db.VarChar(160)
  addressLine2       String?                 @db.VarChar(160)
  city               String                  @db.VarChar(100)
  state              String                  @db.VarChar(100)
  postalCode         String                  @db.VarChar(24)
  country            String                  @db.VarChar(80)
  slug               String                  @unique @db.VarChar(80)
  status             SellerApplicationStatus @default(DRAFT)
  reviewMessage      String?                 @db.VarChar(2000)
  submittedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  history            SellerHistory[]

  @@index([status, submittedAt])
  @@index([createdAt])
}

model SellerHistory {
  id            String                  @id @default(cuid())
  applicationId String?
  sellerId      String?
  actorId       String?
  action        String                  @db.VarChar(50)
  fromStatus    SellerApplicationStatus?
  toStatus      SellerApplicationStatus?
  note          String?                 @db.VarChar(2000)
  createdAt     DateTime                @default(now())
  application   SellerApplication?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  seller        Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  actor         User?                   @relation("SellerHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([sellerId, createdAt])
  @@index([actorId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  parentId  String?
  createdAt DateTime  @default(now())
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id               String                  @id @default(cuid())
  sellerId         String
  categoryId       String
  slug             String                  @unique
  name             String
  description      String
  basePriceMinor   Int
  currency         String                  @default("INR") @db.Char(3)
  status           ProductStatus           @default(DRAFT)
  moderationStatus ProductModerationStatus @default(PENDING_REVIEW)
  moderationNote   String?                 @db.VarChar(2000)
  moderatedAt      DateTime?
  moderatedById    String?
  publishedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  seller           Seller                  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  moderator        User?                   @relation("ProductModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  category         Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  variants         ProductVariant[]
  specifications   ProductSpecification[]
  reviews          Review[]
  wishlist         WishlistItem[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([sellerId, status])
  @@index([moderationStatus, status, publishedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  name      String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String             @id @default(cuid())
  productId         String
  sku               String             @unique
  name              String
  priceMinor        Int?
  stockOnHand       Int                @default(0)
  lowStockThreshold Int                @default(5)
  status            VariantStatus      @default(ACTIVE)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  reservations      InventoryReservation[]
  adjustments       ProductInventoryAdjustment[]

  @@index([productId, status])
  @@index([stockOnHand])
}

model ProductInventoryAdjustment {
  id             String                   @id @default(cuid())
  variantId      String
  actorId        String?
  quantityBefore Int
  quantityChange Int
  quantityAfter  Int
  reason         InventoryAdjustmentReason
  note           String?                  @db.VarChar(500)
  createdAt      DateTime                 @default(now())
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor          User?                    @relation("InventoryAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([actorId, createdAt])
}

model InventoryReservation {
  id          String         @id @default(cuid())
  variantId   String
  orderId     String?
  quantity    Int
  expiresAt   DateTime
  consumedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, expiresAt])
  @@index([orderId, consumedAt])
}

model Order {
  id             String       @id @default(cuid())
  orderNumber    String       @unique @default(cuid())
  userId         String
  status         OrderStatus  @default(PENDING_PAYMENT)
  currency       String       @default("INR") @db.Char(3)
  subtotalMinor  Int
  totalMinor     Int
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerOrders   SellerOrder[]
  reservations   InventoryReservation[]
  payment        Payment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SellerOrder {
  id          String           @id @default(cuid())
  orderId     String
  sellerId    String
  status      SellerOrderStatus @default(PENDING)
  subtotalMinor Int
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller      Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  sellerOrderId  String
  variantId      String
  productName    String
  sku            String
  unitPriceMinor Int
  quantity       Int
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  provider          String
  providerOrderId   String?  @unique
  providerPaymentId String?  @unique
  amountMinor       Int
  currency          String   @db.Char(3)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]

  @@index([status, createdAt])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  providerEventId String   @unique
  eventType       String
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt])
}

model Review {
  id                String   @id @default(cuid())
  productId         String
  userId            String
  rating            Int
  body              String
  verifiedPurchase  Boolean  @default(false)
  createdAt         DateTime @default(now())
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
