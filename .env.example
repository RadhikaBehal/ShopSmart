# Copy to .env for local service development. Do not commit credentials.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
POSTGRES_DB=shopsmart
POSTGRES_USER=shopsmart
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://shopsmart:REPLACE_WITH_URL_SAFE_PASSWORD@localhost:5432/shopsmart?schema=public
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Configure only for the corresponding integration milestone. Never put secrets in Vite/VITE_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_ACCESS_SECRET=
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_API_KEY=
AUTH_EMAIL_FROM_ADDRESS=ShopSmart <onboarding@resend.dev>
